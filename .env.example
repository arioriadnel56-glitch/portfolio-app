# URL de connexion PostgreSQL (fournie automatiquement par Render si tu lies une base Postgres)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Mot de passe admin par défaut (utilisé une seule fois, à la création du compte admin en base)
ADMIN_PASSWORD=admin2026

# Secret utilisé pour signer les jetons de connexion admin (mets une chaîne longue et aléatoire en prod)
JWT_SECRET=change-moi-en-une-longue-chaine-aleatoire

# Port d'écoute (Render le fournit automatiquement, inutile de le changer)
PORT=3000

# Clé API Resend, pour l'envoi réel des emails du formulaire de contact
# (crée un compte gratuit sur https://resend.com puis récupère ta clé)
RESEND_API_KEY=

# Adresse d'expédition des emails. Avant d'avoir vérifié ton propre domaine
# sur Resend, laisse cette valeur par défaut (fonctionne sans configuration) :
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>

# Adresse de secours si jamais le champ "email" n'est pas encore renseigné
# dans l'espace admin (Paramètres) — optionnel.
CONTACT_TO_EMAIL=

# Nécessaires pour activer la connexion par Face ID / empreinte (passkey).
# RP_ID = le domaine exact du site déployé, SANS protocole ni slash
# (ex: mon-portfolio.onrender.com)
RP_ID=

# ORIGIN = l'URL complète du site, AVEC protocole, SANS slash final
# (ex: https://mon-portfolio.onrender.com)
ORIGIN=
